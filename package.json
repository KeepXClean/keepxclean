{
  "name": "keepxclean",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "KeepXClean - High signal-to-noise ratio filter extension for X (Twitter) powered by Cloudflare crowd-sourced blocklist (keepxclean.com)",
  "homepage": "https://keepxclean.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/KeepXClean/keepxclean.git"
  },
  "scripts": {
    "build": "pnpm --filter @keepxclean/shared build && pnpm --filter @keepxclean/extension build && pnpm --filter @keepxclean/web build",
    "dev:ext": "pnpm --filter @keepxclean/extension dev",
    "dev:server": "pnpm --filter @keepxclean/server dev",
    "dev:web": "pnpm --filter @keepxclean/web dev",
    "test": "pnpm --filter @keepxclean/shared test && pnpm --filter @keepxclean/extension test && pnpm --filter @keepxclean/server test && pnpm --filter @keepxclean/web test",
    "test:e2e": "tsx tests/e2e/runner.ts",
    "test:browser": "tsx tests/browser-e2e/extension.smoke.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "pnpm --filter @keepxclean/server db:migrate:local",
    "db:migrate:remote": "pnpm --filter @keepxclean/server db:migrate:remote",
    "cloud-rules:push": "tsx apps/server/scripts/cloud-rules.ts push",
    "cloud-rules:list": "tsx apps/server/scripts/cloud-rules.ts list",
    "release:bump": "tsx scripts/release.ts",
    "cws:auth": "tsx scripts/cws-auth.ts",
    "deploy:server": "pnpm --filter @keepxclean/server run deploy",
    "deploy:web": "pnpm --filter @keepxclean/web build && pnpm --filter @keepxclean/web exec wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.1",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}

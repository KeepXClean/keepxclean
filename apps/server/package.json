    "test": "vitest run"
  },
  "dependencies": {
    "@keepxclean/shared": "workspace:*",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "miniflare": "3.20250718.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "wrangler": "^3.109.0"
  }
}
